  .vehicle-detail-panel .detail-grid { grid-template-columns: 1fr; }
  .driver-detail-panel #driverDetailBase { grid-template-columns: 1fr; }
}

@media (max-width: 620px) {
  .vehicle-detail-panel .detail-header { padding: 18px; }
  .detail-header-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 0; }
  .detail-header-facts > div:nth-child(3) { border-left: 0; padding-left: 0; }
  .vehicle-detail-panel .detail-tabs { gap: 20px; overflow-x: auto; }
  .vehicle-detail-panel .detail-tab { flex: 0 0 auto; }
  .detail-module-heading { align-items: flex-start; min-height: 0; padding: 16px; }
