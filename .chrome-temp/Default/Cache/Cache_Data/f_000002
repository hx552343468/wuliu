/* Keep row actions reachable while wide backend lists scroll horizontally. */
.table-wrap,
.auto-table-wrap {
  position: relative;
  isolation: isolate;
}

.fixed-action-table { --fixed-action-width: 160px; }
#routePage .fixed-action-table { --fixed-action-width: 124px; }
#dispatchPage .fixed-action-table { --fixed-action-width: 132px; }
#autoDispatchPage .fixed-action-table { --fixed-action-width: 92px; }
#customerPage .fixed-action-table { --fixed-action-width: 176px; }
#vehiclePage .fixed-action-table { --fixed-action-width: 172px; }
#driverPage .fixed-action-table { --fixed-action-width: 276px; }

.fixed-action-table .fixed-action-column {
  position: sticky;
  right: 0;
  z-index: 2;
  box-sizing: border-box;
  width: var(--fixed-action-width);
  min-width: var(--fixed-action-width);
  max-width: var(--fixed-action-width);
  border-left: 1px solid #e5eaf2;
  background: #fff;
  box-shadow: -10px 0 16px -14px rgba(38, 53, 82, .72);
}

.fixed-action-table thead .fixed-action-column {
  z-index: 4;
  background: #f7f9fc;
}

.fixed-action-table .fixed-action-column .vehicle-action-group {
  width: 100%;
  justify-content: flex-start;
  white-space: nowrap;
}

.fixed-action-table tbody tr:hover .fixed-action-column { background: #f7faff; }
.fixed-action-table tbody tr.expired-row .fixed-action-column { background: #fff8f8; }
.fixed-action-table tbody tr.expired-row:hover .fixed-action-column { background: #fff1f2; }
.fixed-action-table tbody tr.warning-row .fixed-action-column { background: #fffdf8; }
.fixed-action-table tbody tr.warning-row:hover .fixed-action-column { background: #fff9ee; }
.auto-table-wrap .fixed-action-table tbody tr.selected .fixed-action-column { background: #f1f7ff; }
.auto-table-wrap .fixed-action-table tbody tr:hover .fixed-action-column { background: #f7faff; }

@media (max-width: 720px) {
  #driverPage .fixed-action-table { --fixed-action-width: 258px; }
  #vehiclePage .fixed-action-table,
  #customerPage .fixed-action-table { --fixed-action-width: 164px; }
}

/* Full workspace entry pages: keep all form contracts while presenting dialogs as pages. */
dialog.admin-form-dialog[open] {
  position: fixed;
  inset: 76px 0 0 232px;
  width: calc(100vw - 232px) !important;
  max-width: none !important;
  height: calc(100dvh - 76px) !important;
  max-height: none !important;
  margin: 0 !important;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  padding: 0;
  background: #f3f6fa;
  box-shadow: none;
  animation: entry-page-in .18s ease-out;
}

dialog.admin-form-dialog::backdrop {
  background: transparent;
  backdrop-filter: none;
}

.admin-form-dialog form {
  position: relative;
  display: flex;
  width: 100%;
  height: 100% !important;
  max-height: none !important;
  flex-direction: column;
  background: #f3f6fa;
}

.admin-form-dialog .vehicle-dialog-header {
  position: relative;
  display: block;
  min-height: 108px;
  flex: 0 0 auto;
  padding: 45px 30px 16px !important;
  border: 0;
  background: #f3f6fa;
}

.admin-form-dialog .vehicle-dialog-header::before {
  position: absolute;
  top: 19px;
  left: 30px;
  color: #8e99aa;
  content: attr(data-breadcrumb);
  font-size: 12px;
}

.admin-form-dialog .vehicle-dialog-header strong {
  color: #202c40;
  font-size: 22px;
  font-weight: 700;
  line-height: 1.35;
}

.admin-form-dialog .vehicle-dialog-header span {
  margin-top: 7px;
  color: #8a95a6;
  font-size: 12px;
}

.admin-form-dialog .vehicle-dialog-header .icon-btn {
  display: none;
}

.admin-form-dialog .admin-section-nav {
  gap: 8px;
  min-height: 48px;
  align-items: center;
  padding: 0 30px 10px;
  border: 0;
  background: #f3f6fa;
}

.admin-form-dialog .admin-section-nav button {
  min-height: 36px;
  border: 1px solid #e1e6ee;
  border-radius: 5px;
  padding: 0 16px;
  color: #56647a;
  background: #fff;
  font-size: 13px;
  font-weight: 500;
}

.admin-form-dialog .admin-section-nav button:hover {
  border-color: #b9ccef;
  color: var(--primary);
}

.admin-form-dialog .admin-section-nav button.is-active {
  border-color: var(--primary);
  color: #fff;
  background: var(--primary);
  box-shadow: 0 4px 10px rgba(20, 120, 212, .14);
}

.admin-form-dialog .admin-section-nav button.is-active::after { display: none; }

.admin-form-dialog .admin-form-scroll,
.admin-form-dialog .driver-form-body,
.admin-form-dialog .waybill-form-body {
  min-height: 0;
  max-height: none;
  flex: 1 1 auto;
  overflow-x: hidden;
  overflow-y: auto;
  padding: 14px 30px 36px;
  background: #f3f6fa;
  scrollbar-color: #b9c7d9 #edf1f6;
  scrollbar-width: thin;
}

.admin-form-dialog .admin-form-scroll::-webkit-scrollbar,
.admin-form-dialog .driver-form-body::-webkit-scrollbar,
.admin-form-dialog .waybill-form-body::-webkit-scrollbar { width: 7px; }
.admin-form-dialog .admin-form-scroll::-webkit-scrollbar-track,
.admin-form-dialog .driver-form-body::-webkit-scrollbar-track,
.admin-form-dialog .waybill-form-body::-webkit-scrollbar-track { background: #edf1f6; }
.admin-form-dialog .admin-form-scroll::-webkit-scrollbar-thumb,
.admin-form-dialog .driver-form-body::-webkit-scrollbar-thumb,
.admin-form-dialog .waybill-form-body::-webkit-scrollbar-thumb { border-radius: 5px; background: #b9c7d9; }

.admin-form-dialog .driver-form-section,
.admin-form-dialog .waybill-form-section {
  margin: 0 0 14px;
  border: 1px solid #e3e8ef;
  border-radius: 7px;
  padding: 24px 26px 28px;
  background: #fff;
  box-shadow: 0 3px 12px rgba(31, 47, 72, .035);
  scroll-margin-top: 12px;
}

.admin-form-dialog .driver-form-section:last-child,
.admin-form-dialog .waybill-form-section:last-child { border-bottom: 1px solid #e3e8ef; }

.admin-form-dialog .driver-form-section h3 {
  margin: 0 0 22px;
  border-bottom: 1px solid #edf0f4;
  padding-bottom: 15px;
  color: #26354c;
  font-size: 16px;
  font-weight: 700;
}

.admin-form-dialog .form-grid,
.admin-form-dialog.driver-dialog .driver-form-body .form-grid,
.admin-form-dialog.dispatch-dialog .driver-form-body .form-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 21px 18px;
  max-height: none;
  overflow: visible;
  padding: 0;
}

.admin-form-dialog .field {
  gap: 8px;
  color: #59667a;
  font-size: 12px;
  font-weight: 500;
}

.admin-form-dialog .field input:not([type="checkbox"]):not([type="file"]),
.admin-form-dialog .field select,
.admin-form-dialog .field textarea {
  min-height: 42px;
  border: 1px solid #dfe5ed;
  border-radius: 5px;
  padding-right: 12px;
  padding-left: 12px;
  color: #2f3c50;
  background: #fff;
  font-size: 13px;
}

.admin-form-dialog .field textarea { min-height: 78px; padding-top: 11px; padding-bottom: 11px; }
.admin-form-dialog .field input::placeholder,
.admin-form-dialog .field textarea::placeholder { color: #a9b1bd; }

.admin-form-dialog .field input:focus-visible,
.admin-form-dialog .field select:focus-visible,
.admin-form-dialog .field textarea:focus-visible {
  border-color: #4b82e8;
  outline: 0;
  box-shadow: 0 0 0 3px rgba(47, 111, 229, .1);
}

.admin-form-dialog .form-actions,
.admin-form-dialog .waybill-form-actions {
  position: relative;
  z-index: 4;
  top: auto;
  right: auto;
  display: flex;
  min-height: 72px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  margin: 0;
  border: 0;
  border-top: 1px solid #e1e6ee;
  padding: 14px 30px !important;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 -8px 20px rgba(31, 47, 72, .05);
  backdrop-filter: blur(10px);
}

.admin-form-dialog .waybill-form-actions { justify-content: space-between; }
.admin-form-dialog .waybill-form-actions > .form-tip { display: block; }
.admin-form-dialog .form-actions .btn,
.admin-form-dialog .waybill-form-actions .btn {
  min-width: 104px;
  height: 40px;
  border-radius: 5px;
  box-shadow: none;
}

.admin-form-dialog .form-actions .btn.quiet,
.admin-form-dialog .waybill-form-actions .btn.quiet {
  border-color: #dfe5ed;
  color: #56647a;
  background: #fff;
}

.admin-form-dialog .form-actions .btn.primary,
.admin-form-dialog .waybill-form-actions .btn.primary {
  border-color: var(--primary);
  background: var(--primary);
}

.admin-form-dialog .waybill-section-title { margin-bottom: 20px; }
.admin-form-dialog .waybill-section-title h3 { color: #26354c; font-size: 16px; }
.admin-form-dialog .waybill-section-title p { margin-top: 5px; }
.admin-form-dialog .waybill-generated-summary {
  margin-bottom: 24px;
  border: 1px solid #e7ebf1;
  border-radius: 6px;
  padding: 16px 18px;
  background: #f8fafc;
}
.admin-form-dialog .waybill-form-grid { gap: 20px 18px; }
.admin-form-dialog .container-entry-block { margin-top: 26px; }
.admin-form-dialog .fee-section { padding: 24px 26px 28px; }
.admin-form-dialog .fee-section .waybill-section-heading { padding: 0 0 18px; }
.admin-form-dialog .fee-section .fee-table-wrap { overflow: auto; border: 1px solid #e5e9f0; border-radius: 5px; }
.admin-form-dialog .profit-summary { margin: 2px 0 0; border-radius: 6px; }

.admin-form-dialog .dispatch-readonly-summary {
  margin-top: 24px;
  border: 1px solid #e7ebf1;
  border-radius: 6px;
  padding: 18px;
  background: #f8fafc;
}
.admin-form-dialog .push-note { margin: 0; }

/* Customer entry follows the same page grammar without changing its existing form. */
.customer-entry-page {
  position: fixed;
  z-index: 4;
  inset: 76px 0 0 232px;
  display: flex;
  height: calc(100dvh - 76px);
  flex-direction: column;
  overflow: hidden;
  max-width: none;
  margin: 0;
  padding: 0 30px;
  background: #f3f6fa;
}

.customer-entry-header {
  min-height: 108px;
  align-items: center;
  gap: 14px;
  flex: 0 0 auto;
  padding: 20px 0 14px;
}
.customer-entry-header .customer-back {
  display: grid;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid #dfe5ed;
  border-radius: 5px;
  color: #55647a;
  background: #fff;
  font-size: 18px;
}
.customer-entry-header h2 { color: #202c40; font-size: 22px; }
.customer-entry-header p { margin-top: 6px; }
.customer-section-nav {
  display: flex;
  gap: 8px;
  min-height: 48px;
  align-items: center;
  flex: 0 0 auto;
  padding-bottom: 10px;
}
.customer-section-nav button {
  min-height: 36px;
  border: 1px solid #e1e6ee;
  border-radius: 5px;
  padding: 0 16px;
  color: #56647a;
  background: #fff;
  font-size: 13px;
}
.customer-section-nav button.is-active {
  border-color: var(--primary);
  color: #fff;
  background: var(--primary);
}
.customer-entry-page > form {
  position: static;
  min-height: 0;
  flex: 1 1 auto;
  overflow-x: hidden;
  overflow-y: auto;
  border: 0;
  border-radius: 0;
  padding: 14px 0 28px;
  background: transparent;
  box-shadow: none;
  scrollbar-color: #b9c7d9 #edf1f6;
  scrollbar-width: thin;
}
.customer-entry-page > form::-webkit-scrollbar { width: 7px; }
.customer-entry-page > form::-webkit-scrollbar-track { background: #edf1f6; }
.customer-entry-page > form::-webkit-scrollbar-thumb { border-radius: 5px; background: #b9c7d9; }
.customer-form-notice {
  margin-bottom: 14px;
  border: 1px solid #dce7fa;
  border-radius: 7px;
  background: #f8fbff;
}
.customer-entry-section {
  margin-bottom: 14px;
  border: 1px solid #e3e8ef;
  border-radius: 7px;
  padding: 27px 28px 30px;
  background: #fff;
  box-shadow: 0 3px 12px rgba(31, 47, 72, .035);
  scroll-margin-top: 90px;
}
.customer-entry-section:last-of-type { border-bottom: 1px solid #e3e8ef; }
.customer-section-heading > span { border-radius: 5px; }
.customer-entry-grid input,
.customer-entry-grid select,
.customer-entry-grid textarea {
  min-height: 42px;
  border-radius: 5px;
  padding-right: 12px;
  padding-left: 12px;
}
.customer-entry-actions {
  position: relative;
  inset: auto;
  z-index: 6;
  min-height: 72px;
  flex: 0 0 auto;
  align-items: center;
  border: 0;
  border-top: 1px solid #e1e6ee;
  border-radius: 0;
  margin: 0 -30px;
  padding: 14px 30px;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 -8px 20px rgba(31, 47, 72, .05);
  backdrop-filter: blur(10px);
}
.customer-entry-actions > span { display: block; }
.customer-entry-actions .btn { min-width: 104px; height: 40px; border-radius: 5px; }

@keyframes entry-page-in {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 1360px) {
  .admin-form-dialog .vehicle-dialog-header { padding-right: 30px !important; }
  .admin-form-dialog .form-grid,
  .admin-form-dialog.driver-dialog .driver-form-body .form-grid,
  .admin-form-dialog.dispatch-dialog .driver-form-body .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .customer-entry-header { padding-right: 0; }
  .customer-entry-section { grid-template-columns: 160px minmax(0, 1fr); gap: 22px; }
  .customer-entry-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
