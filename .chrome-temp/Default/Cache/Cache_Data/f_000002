:root {
  --sidebar: #27313f;
  --sidebar-deep: #202937;
  --sidebar-active: #1677d2;
  --page: #edf1f5;
  --surface: #ffffff;
  --line: #d8e0ea;
  --line-strong: #c4cfdc;
  --text: #1f2937;
  --muted: #667085;
  --primary: #1478d4;
  --primary-hover: #0f67b5;
  --accent: #f28b26;
  --accent-hover: #d97615;
  --success: #1c9b63;
  --shadow: 0 10px 24px rgba(31, 41, 55, 0.08);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 1180px;
  color: var(--text);
  background: var(--page);
  font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
  font-size: 14px;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 232px;
  color: #eef6ff;
  background: linear-gradient(180deg, var(--sidebar), var(--sidebar-deep));
  box-shadow: 6px 0 18px rgba(20, 32, 48, 0.14);
  z-index: 3;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  height: 76px;
  padding: 0 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.brand-mark {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 8px;
  background: #18a0c8;
  color: #fff;
  font-weight: 800;
}

.brand strong {
  display: block;
  font-size: 18px;
}

.brand span {
  display: block;
  margin-top: 3px;
  color: rgba(238, 246, 255, 0.68);
  font-size: 12px;
}

.nav-menu {
  padding: 14px 10px;
}

.nav-item,
.nav-parent,
.nav-child {
  width: 100%;
  border: 0;
  color: inherit;
  text-align: left;
  background: transparent;
}

.nav-item,
.nav-parent {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 6px;
}

.nav-item:hover,
.nav-parent:hover {
  background: rgba(255, 255, 255, 0.08);
}

.nav-section.active {
  margin-bottom: 6px;
  padding: 6px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.08);
}

.nav-child {
  display: block;
  margin: 4px 0 0 34px;
  width: calc(100% - 34px);
  min-height: 36px;
  padding: 0 14px;
  border-radius: 6px;
  color: #d9edff;
}

.nav-child.selected {
  background: var(--sidebar-active);
  color: #fff;
  font-weight: 700;
}

.nav-icon {
  display: inline-grid;
  width: 18px;
  place-items: center;
  color: #85c8ff;
}

.main-panel {
  width: calc(100% - 232px);
  min-height: 100vh;
  margin-left: 232px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76px;
  padding: 0 28px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
}

.system-kicker {
  margin: 0 0 4px;
  color: var(--muted);
  font-size: 12px;
}

h1 {
  margin: 0;
  font-size: 24px;
  letter-spacing: 0;
}

.user-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 34px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #f8fafc;
  color: #475467;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mobile-entry {
  display: inline-flex;
  align-items: center;
  height: 34px;
  border: 1px solid #dbe5fb;
  border-radius: 18px;
  padding: 0 14px;
  background: #edf3ff;
  color: var(--primary);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.mobile-entry:hover {
  border-color: #abc1f6;
  background: #e2ebff;
}

.mobile-entry.admin-mobile-entry {
  border-color: #d8e9e4;
  background: #edf8f5;
  color: #217a67;
}

.mobile-entry.admin-mobile-entry:hover {
  border-color: #acd7cc;
  background: #e2f3ee;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--success);
}

.workspace {
  padding: 16px 22px 24px;
}

.tabs {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 38px;
}

.tab {
  min-width: 98px;
  height: 36px;
  border: 1px solid var(--line);
  border-bottom: 0;
  border-radius: 6px 6px 0 0;
  background: #f8fafc;
  color: #4b5563;
}

.tab.active {
  height: 38px;
  background: var(--surface);
  color: var(--primary);
  font-weight: 700;
}

.page-view,
.vehicle-module,
.hidden-panel {
  display: none;
}

.page-view.active,
.vehicle-module.active,
.hidden-panel.open {
  display: block;
}

.query-panel,
.table-card,
.pagination,
.form-card,
.vehicle-dashboard {
  border: 1px solid var(--line);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.query-panel {
  padding: 16px;
  border-radius: 0 6px 6px 6px;
}

.query-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(142px, 1fr));
  gap: 12px;
}

.vehicle-query-grid {
  grid-template-columns: 180px 180px 160px 1fr;
  align-items: end;
}

.field,
.dialog-grid label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #344054;
  font-weight: 600;
}

.field input,
.field select,
.file-field input,
.dialog-grid input,
.pagination select,
.pagination input {
  width: 100%;
  height: 34px;
  border: 1px solid var(--line-strong);
  border-radius: 4px;
  padding: 0 10px;
  background: #fff;
  color: var(--text);
  outline: none;
}

.file-field input {
  padding: 6px 10px;
  height: 38px;
}

.field input:focus,
.field select:focus,
.file-field input:focus,
.dialog-grid input:focus,
.pagination select:focus,
.pagination input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(20, 120, 212, 0.12);
}

.query-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 14px;
}

.radio-group {
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 36px;
  margin: 0;
  padding: 0;
  border: 0;
}

.radio-group legend {
  float: left;
  margin-right: 12px;
  color: #344054;
  font-weight: 700;
}

.radio-group label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #475467;
}

.action-bar {
  position: relative;
  display: flex;
  gap: 10px;
}

.query-actions-inline {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

.btn {
  min-width: 92px;
  height: 36px;
  border: 1px solid transparent;
  border-radius: 4px;
  padding: 0 14px;
  color: #fff;
  font-weight: 700;
}

.btn.primary {
  background: var(--primary);
}

.btn.primary:hover {
  background: var(--primary-hover);
}

.btn.accent {
  background: var(--accent);
}

.btn.accent:hover {
  background: var(--accent-hover);
}

.btn.quiet {
  border-color: var(--line-strong);
  background: #fff;
  color: #344054;
}

.link-btn {
  height: 28px;
  border: 1px solid #bddffb;
  border-radius: 4px;
  padding: 0 10px;
  background: #eef8ff;
  color: var(--primary);
  font-weight: 700;
}

.link-btn:hover {
  border-color: var(--primary);
  background: #dff0ff;
}

.more-menu {
  position: absolute;
  top: 42px;
  right: 0;
  display: none;
  width: 136px;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #fff;
  box-shadow: 0 16px 34px rgba(31, 41, 55, 0.16);
  z-index: 4;
}

.more-menu.open {
  display: block;
}

.more-menu button {
  width: 100%;
  height: 34px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: #344054;
  text-align: left;
}

.more-menu button:hover {
  background: #eef6ff;
  color: var(--primary);
}

.table-card {
  margin-top: 14px;
  border-radius: 6px;
  overflow: hidden;
}

.table-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: 48px;
  padding: 0 14px;
  border-bottom: 1px solid var(--line);
  background: #fbfcfe;
}

.table-summary strong {
  margin-right: 10px;
}

.table-summary span {
  color: var(--muted);
}

.draft-badge {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 0 10px;
  border: 1px solid #bddffb;
  border-radius: 4px;
  background: #eef8ff;
  color: var(--primary) !important;
  font-weight: 700;
}

.warning-badge {
  border-color: #fed7aa;
  background: #fff7ed;
  color: #c2410c !important;
}

.table-wrap {
  width: 100%;
  overflow: auto;
  background: #fff;
}

table {
  width: max-content;
  min-width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

th,
td {
  height: 42px;
  padding: 0 10px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
  text-align: left;
  font-size: 13px;
}

th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: #eef3f8;
  color: #334155;
  font-weight: 700;
}

tbody tr:nth-child(even) td {
  background: #fbfdff;
}

tbody tr:hover td {
  background: #eef7ff;
}

tbody tr.expired-row td {
  background: #fff1f2;
  color: #9f1239;
}

tbody tr.expired-row:hover td {
  background: #ffe4e6;
}

tbody tr.warning-row td {
  background: #fff7ed;
}

tbody tr.warning-row:hover td {
  background: #ffedd5;
}

.check-col {
  min-width: 98px;
}

.checkbox-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.state-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 48px;
  min-height: 24px;
  border-radius: 4px;
  background: #fff7e8;
  color: #b55e00;
  font-weight: 700;
}

.state-pill.active-state {
  background: #ecfdf3;
  color: #027a48;
}

.state-pill.stop-state {
  background: #f2f4f7;
  color: #475467;
}

.state-pill.maintenance-state {
  background: #fff4e5;
  color: #b7640c;
}

.state-pill.scrap-state {
  background: #fef3f2;
  color: #b42318;
}

.due-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92px;
  min-height: 24px;
  border-radius: 4px;
  padding: 0 8px;
  font-weight: 700;
}

.due-pill.normal {
  background: #ecfdf3;
  color: #027a48;
}

.due-pill.insurance {
  background: #eff6ff;
  color: #175cd3;
}

.due-pill.inspection {
  background: #fff7ed;
  color: #c2410c;
}

.due-pill.expired {
  background: #ffe4e6;
  color: #be123c;
}

.money {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 54px;
  margin-top: 14px;
  padding: 0 14px;
  border-radius: 6px;
}

.pagination label,
.page-controls {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.pagination select {
  width: 76px;
}

.pagination input {
  width: 62px;
}

.page-controls button {
  min-width: 34px;
  height: 32px;
  border: 1px solid var(--line-strong);
  border-radius: 4px;
  background: #fff;
  color: #344054;
}

.page-controls button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.page-controls .page-current {
  border-color: var(--primary);
  background: var(--primary);
  color: #fff;
}

.add-dialog {
  width: 560px;
  border: 0;
  border-radius: 8px;
  padding: 0;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.28);
}

.add-dialog::backdrop {
  background: rgba(15, 23, 42, 0.42);
}

.add-dialog form {
  margin: 0;
}

.add-dialog header,
.add-dialog footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--line);
}

.add-dialog footer {
  justify-content: flex-end;
  gap: 10px;
  border-top: 1px solid var(--line);
  border-bottom: 0;
}

.add-dialog h2 {
  margin: 0;
  font-size: 18px;
}

.icon-btn {
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 4px;
  background: #f2f4f7;
  color: #475467;
  font-size: 20px;
}

.dialog-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  padding: 18px;
}

.vehicle-dashboard {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 12px;
  margin-bottom: 14px;
  padding: 14px;
  border-radius: 6px;
}

#vehiclePage.detail-mode > .vehicle-dashboard,
#vehiclePage.detail-mode > #vehicleQueryForm {
  display: none;
}

.reminder-card {
  min-height: 94px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #fbfcfe;
}

.reminder-card strong {
  display: block;
  margin-bottom: 8px;
  color: #475467;
}

.reminder-card span {
  display: block;
  color: #111827;
  font-size: 28px;
  font-weight: 800;
  line-height: 1;
}

.reminder-card small {
  display: block;
  margin-top: 8px;
  color: var(--muted);
}

.reminder-card.expired {
  border-color: #fecdd3;
  background: #fff1f2;
}

.reminder-card.insurance {
  border-color: #bfdbfe;
  background: #eff6ff;
}

.reminder-card.inspection {
  border-color: #fed7aa;
  background: #fff7ed;
}

.module-tabs {
  display: flex;
  gap: 8px;
  margin-top: 14px;
  border-bottom: 1px solid var(--line);
}

.detail-tabs {
  display: flex;
  gap: 8px;
  border-bottom: 1px solid var(--line);
  background: #fbfcfe;
  padding: 0 14px;
}

.module-tab,
.detail-tab {
  min-width: 128px;
  height: 38px;
  border: 1px solid var(--line);
  border-bottom: 0;
  border-radius: 6px 6px 0 0;
  background: #f8fafc;
  color: #475467;
}

.module-tab.active,
.detail-tab.active {
  background: #fff;
  color: var(--primary);
  font-weight: 700;
}

.vehicle-detail-panel {
  margin-top: 14px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #fff;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px;
  border-bottom: 1px solid var(--line);
}

.detail-header span,
.detail-header small {
  display: block;
  color: var(--muted);
}

.detail-header strong {
  display: block;
  margin: 4px 0;
  font-size: 20px;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(160px, 1fr));
  gap: 1px;
  background: var(--line);
}

.detail-item {
  min-height: 72px;
  padding: 12px;
  background: #fff;
}

.detail-item span {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 12px;
}

.detail-item strong {
  display: block;
  color: var(--text);
  font-size: 14px;
}

.form-card {
  margin-top: 14px;
  padding: 16px;
  border-radius: 6px;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
}

.section-title strong {
  display: block;
  font-size: 16px;
}

.section-title span {
  display: block;
  margin-top: 4px;
  color: var(--muted);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 12px;
}

@media (max-width: 1320px) {
  .query-grid {
    grid-template-columns: repeat(3, minmax(160px, 1fr));
  }

  .vehicle-query-grid,
  .form-grid,
  .detail-grid,
  .vehicle-dashboard {
    grid-template-columns: repeat(2, minmax(180px, 1fr));
  }

  .query-actions-inline {
    justify-content: flex-start;
  }
}

/* Enterprise workspace refresh */
:root {
  --sidebar: #ffffff;
  --sidebar-deep: #ffffff;
  --sidebar-active: #4779ed;
  --page: #f4f6fa;
  --surface: #ffffff;
  --line: #e8ecf3;
  --line-strong: #d9e0eb;
  --text: #172033;
  --muted: #96a1b3;
  --primary: #4779ed;
  --primary-hover: #3868d9;
  --accent: #f59a3d;
  --accent-hover: #e78524;
  --success: #20a86b;
  --shadow: 0 2px 6px rgba(29, 43, 72, 0.03), 0 8px 20px rgba(29, 43, 72, 0.035);
}

body { color: var(--text); background: var(--page); }

.sidebar {
  width: 248px;
  padding: 0 12px;
  color: #657187;
  background: #fff;
  box-shadow: none;
  border-right: 1px solid var(--line);
}

.brand {
  gap: 11px;
  height: 78px;
  padding: 0 12px;
  border-bottom-color: var(--line);
}

.brand-mark {
  border-radius: 10px;
  background: linear-gradient(145deg, #5c8cff, #3d6fe6);
  box-shadow: 0 5px 12px rgba(71, 121, 237, 0.25);
  font-size: 18px;
}

.brand strong { color: #263b64; letter-spacing: 0; }
.brand span { margin-top: 2px; color: #a0aabd; font-size: 11px; }
.nav-menu { padding: 18px 5px; }

.nav-item, .nav-parent {
  gap: 12px;
  min-height: 46px;
  padding: 0 13px;
  border-radius: 7px;
  font-weight: 600;
  transition: background-color .18s ease, color .18s ease;
}

.nav-item:hover, .nav-parent:hover { color: var(--primary); background: #f6f8fc; }
.nav-section { margin-bottom: 4px; }
.nav-section.active { margin-bottom: 6px; padding: 0; background: transparent; }

.nav-child {
  width: calc(100% - 28px);
  min-height: 40px;
  margin: 1px 0 3px 28px;
  padding: 0 13px;
  border-radius: 6px;
  color: #738096;
  font-weight: 500;
}

.nav-child:hover { color: var(--primary); background: #f4f7ff; }
.nav-child.selected {
  color: var(--primary);
  background: #edf3ff;
  box-shadow: inset 3px 0 0 var(--primary);
  font-weight: 700;
}

.nav-icon { color: #95a2b8; font-size: 16px; }
.nav-section.active .nav-parent .nav-icon { color: var(--primary); }
.main-panel { width: calc(100% - 248px); margin-left: 248px; }

.topbar {
  height: 78px;
  padding: 0 32px;
  border-bottom-color: var(--line);
  background: rgba(255, 255, 255, .94);
  backdrop-filter: blur(16px);
}

.system-kicker { margin-bottom: 4px; color: #9aa5b5; }
h1 { color: #1c2a43; font-size: 21px; }
.user-chip {
  min-height: 34px;
  border-color: #e6ebf4;
  border-radius: 18px;
  background: #f8faff;
  color: #526078;
  font-size: 13px;
}
.status-dot { width: 7px; height: 7px; box-shadow: 0 0 0 3px #eaf9f1; }

.workspace { padding: 20px 28px 30px; }
.tabs {
  gap: 24px;
  height: 42px;
  padding: 0 14px;
  border-color: var(--line);
  border-bottom: 0;
  border-radius: 8px 8px 0 0;
  background: #fff;
}

.tab {
  position: relative;
  min-width: 0;
  height: 42px;
  padding: 0 3px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #7c8799;
  font-weight: 600;
}

.tab:hover, .tab.active { color: var(--primary); }
.tab.active { height: 42px; background: transparent; }
.tab.active::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 3px;
